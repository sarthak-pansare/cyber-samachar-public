# Application environment: development | qa | staging | production
APP_ENV=
NEXT_PUBLIC_APP_ENV=
NEXT_PUBLIC_SITE_URL=

# Environment policy
DEBUG_LOGGING=
AUTH_CAPTCHA_MODE=
NEXT_PUBLIC_AUTH_CAPTCHA_MODE=
EMAIL_DELIVERY_MODE=
AUTOMATION_ENABLED=
ADMIN_MUTATION_MODE=

# Required only outside Production
NON_PROD_ACCESS_USERNAME=
NON_PROD_ACCESS_PASSWORD=
TEST_EMAIL_ALLOWLIST=

# Public content database access
NEXT_PUBLIC_CONTENT_SUPABASE_URL=
NEXT_PUBLIC_CONTENT_SUPABASE_ANON_KEY=

# Public and server-side user database access
NEXT_PUBLIC_USER_SUPABASE_URL=
NEXT_PUBLIC_USER_SUPABASE_ANON_KEY=
USER_DB_URL=
USER_DB_SERVICE_KEY=

# CAPTCHA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional application features
REPORTS_ENABLED=

# CI/operator variables stay in GitHub or local ignored files, never Vercel runtime.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
